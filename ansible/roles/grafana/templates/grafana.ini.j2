# ==========================================================
# NexGenAds Grafana configuration — managed by Ansible
# ==========================================================
# This file is generated by roles/grafana/templates/grafana.ini.j2
# and is owned by the Ansible grafana role.
#
# Required deployment settings (preserved by the role):
#   http_port           = {{ grafana_port }}
#   domain              = {{ grafana_domain }}
#   root_url            = {{ grafana_root_url }}
#   serve_from_sub_path = true
#
# Grafana must remain behind Nginx + Cloudflare. It is NOT
# exposed directly to the Internet.
#
# The original configuration is preserved automatically as a
# timestamped backup whenever this file changes.

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
[server]

# The IP address to bind to. Loopback only: Nginx proxies all
# external traffic, Cloudflare never talks to Grafana directly.
http_addr = {{ grafana_bind_address }}

# The http port to bind to.
http_port = {{ grafana_port }}

# The full public-facing URL used to build absolute paths.
domain = {{ grafana_domain }}
root_url = {{ grafana_root_url }}

# Serve Grafana from the configured sub-path.
serve_from_sub_path = true

# ----------------------------------------------------------
# Paths
# ----------------------------------------------------------
[paths]

data = /var/lib/grafana
logs = /var/log/grafana
plugins = /var/lib/grafana/plugins
provisioning = /etc/grafana/provisioning

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
[database]

# SQLite database is the default and matches the current setup.
type = sqlite3
path = grafana.db

# ----------------------------------------------------------
# Session
# ----------------------------------------------------------
[session]

provider = file

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------
[log]

mode = console file
level = info

# ----------------------------------------------------------
# Grafana.net / updates
# ----------------------------------------------------------
[grafana_net]
url = https://grafana.com

[metrics]
enabled = true

[snapshots]
external_enabled = false
